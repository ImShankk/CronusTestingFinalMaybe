# Cronus configuration. Copy to .env and fill in what you need.
# Only GOOGLE_API_KEY is required; everything else has a sensible default.

# ---------------------------------------------------------------- required
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# ---------------------------------------------------------------- model
CRONUS_MODEL=gemini-flash-latest
CRONUS_TEMPERATURE=0.7
CRONUS_MAX_OUTPUT_TOKENS=2048
CRONUS_LLM_TIMEOUT=45

# ---------------------------------------------------------------- assistant
# How many tool round trips one request may take before Cronus wraps up.
CRONUS_MAX_TOOL_ITERATIONS=8
CRONUS_TOOL_TIMEOUT=30
# Rough character budget for everything sent to the model each turn.
CRONUS_CONTEXT_BUDGET=12000
CRONUS_USER_NAME=
# IANA name, e.g. America/Edmonton. Used for the clock, "tomorrow", and
# reminder times. Needs the tzdata package on Windows (in requirements.txt).
CRONUS_TIMEZONE=
# Where you are. Used for weather and other local questions so Cronus never
# has to guess a city. e.g. Edmonton, Alberta, Canada
CRONUS_LOCATION=

# ---------------------------------------------------------------- storage
# Database, logs, and long-term memory live here.
CRONUS_DATA_DIR=
CRONUS_LOG_LEVEL=INFO

# ---------------------------------------------------------------- memory
CRONUS_MEMORY_RECALL=6
CRONUS_MEMORY_MAX=500

# ---------------------------------------------------------------- email
# Gmail needs an app password, not your account password:
# https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
CRONUS_SMTP_HOST=smtp.gmail.com
CRONUS_SMTP_PORT=587

# ---------------------------------------------------------------- files
# Comma-separated folders Cronus may read and write. Leave blank to use
# Documents, Desktop, and Downloads. Set it to nothing Cronus should touch
# and file tools will refuse every path outside these roots.
CRONUS_FILE_ROOTS=
CRONUS_MAX_READ_BYTES=200000

# ---------------------------------------------------------------- permissions
# Override a tool's default permission: allow, confirm, or block.
# A tool marked BLOCKED in code can never be re-enabled here.
# Example: CRONUS_TOOL_PERMISSIONS=send_email=allow,delete_file=block
CRONUS_TOOL_PERMISSIONS=
CRONUS_CONFIRMATION_TIMEOUT=120

# Extra applications open_app may launch, as name=command pairs.
# Example: CRONUS_ALLOWED_APPS=editor=code,music=spotify
CRONUS_ALLOWED_APPS=

# ---------------------------------------------------------------- voice
CRONUS_VOICE=false
# How a turn begins:
#   continuous   - Cronus listens again after every reply (recommended)
#   push_to_talk - press Enter before each turn
#   wake_word    - stay idle until the wake phrase is heard
CRONUS_VOICE_MODE=continuous
# piper (local, best quality) or sapi (Windows built-in, no download).
CRONUS_TTS_PROVIDER=piper

# Piper: download the binary from https://github.com/rhasspy/piper/releases and
# a voice from https://huggingface.co/rhasspy/piper-voices
#
#   <install>/piper/piper.exe          the executable itself, not its folder
#   <install>/voices/<voice>.onnx      keep <voice>.onnx.json beside it;
#                                      Piper finds the JSON on its own
#
# Point CRONUS_PIPER_MODEL at the .onnx, never the .json. Windows example:
#   CRONUS_PIPER_EXE=C:\piper_windows_amd64\piper\piper.exe
#   CRONUS_PIPER_MODEL=C:\piper_windows_amd64oices\en_US-ryan-high.onnx
# Leave both blank and Cronus falls back to the Windows SAPI voice, saying so.
CRONUS_PIPER_EXE=
CRONUS_PIPER_MODEL=

# Speaking speed. 1.0 is the voice's natural pace; higher is faster. Around
# 1.2 to 1.25 sounds conversational rather than like narration. Values above
# about 2.0 stop having any further effect.
CRONUS_SPEECH_RATE=1.25

# Leave the microphone index blank for the system default.
CRONUS_MIC_INDEX=
CRONUS_MIC_ENERGY_THRESHOLD=
# Longest single utterance Cronus will record.
CRONUS_PHRASE_TIME_LIMIT=30
# How long to wait for you to start speaking before giving up on a turn.
CRONUS_LISTEN_TIMEOUT=15
# Silence that ends a phrase. Raise it if Cronus cuts you off when you pause
# to think; lower it if replies feel slow to start.
CRONUS_PAUSE_THRESHOLD=1.0
# Silence kept either side of what you said. Must not exceed the pause above.
CRONUS_NON_SPEAKING_DURATION=0.5
# Ignore noises shorter than this, so a cough is not treated as a request.
CRONUS_MIN_SPEECH_SECONDS=0.3

# Talking over Cronus stops it speaking and starts listening.
CRONUS_BARGE_IN=true
# How much louder than the room speech must be to count as an interruption.
# Raise it if Cronus interrupts itself through your speakers; headphones help.
CRONUS_BARGE_IN_SENSITIVITY=2.5

# Hands-free activation. See the README for what this costs.
CRONUS_WAKE_WORD_ENABLED=false
CRONUS_WAKE_WORD=hey cronus
